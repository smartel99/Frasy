Lowest value read on channel 2, in volts.
Only valid when `Samples to Take` is 0.
</description>
            <REAL />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_600A0C">
            <description lang="en">#### Channel 2 Average
Average value read on channel 2, in volts.
Only valid when `Samples to Take` is 0.
</description>
            <REAL />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_600A0D">
            <description lang="en">#### Channel 2 Max
Highest value read on channel 2, in volts.
Only valid when `Samples to Take` is 0.
</description>
            <REAL />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_600A0E">
            <description lang="en">#### Channel 3 Min
Lowest value read on channel 3, in volts.
Only valid when `Samples to Take` is 0.
</description>
            <REAL />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_600A0F">
            <description lang="en">#### Channel 3 Average
Average value read on channel 3, in volts.
Only valid when `Samples to Take` is 0.
</description>
            <REAL />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_600A10">
            <description lang="en">#### Channel 3 Max
Highest value read on channel 3, in volts.
Only valid when `Samples to Take` is 0.
</description>
            <REAL />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_600A11">
            <description lang="en">#### Channel 4 Min
Lowest value read on channel 4, in volts.
Only valid when `Samples to Take` is 0.
</description>
            <REAL />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_600A12">
            <description lang="en">#### Channel 4 Average
Average value read on channel 4, in volts.
Only valid when `Samples to Take` is 0.
</description>
            <REAL />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_600A13">
            <description lang="en">#### Channel 4 Max
Highest value read on channel 4, in volts.
Only valid when `Samples to Take` is 0.
</description>
            <REAL />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_600A14" access="readWrite">
            <label lang="en">Stored Sample Index</label>
            <INT />
            <q1:defaultValue value="0" />
            <q1:allowedValues>
              <q1:range>
                <minValue value="0" />
                <maxValue value="999" />
              </q1:range>

            <q1:defaultValue value="0x14" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_600B01">
            <description lang="en">#### Channel 1 Gain 100R
Gain of channel 1 (IMP_+) when in the 100 ohms range.
